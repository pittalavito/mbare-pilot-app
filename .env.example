# APP
APP_LOG_LEVEL=INFO

# UI (frontend in ui/, resource/scripts/run-ui.py): it only talks to the API at API_URL
UI_PORT=8502
API_URL=http://127.0.0.1:8000
# restart the API by itself when src/ changes (development)
API_RELOAD=true

# Processes started from the UI Backend panel and scripts it mentions (paths from the project root)
API_APP=api:app
API_APP_DIR=src
WORKER_SCRIPT=src/worker.py
SCRIPT_START_DOCKER=resource/scripts/start-docker.py

# POSTGRES
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST_PORT=5433
POSTGRES_DASHBOARD_PORT=8084
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
# container the DB export runs pg_dump in (resource/docker/docker-compose.yml)
POSTGRES_CONTAINER=mbare-pilot-app-postgres

# BACKUP: DB exports go to <BACKUP_DIR>/db/ (empty = the mbare-pilot-back-up folder next to the project)
BACKUP_DIR=

# REDIS
REDIS_HOST_PORT=6380
REDIS_DASHBOARD_PORT=8083
REDIS_URL=redis://localhost:${REDIS_HOST_PORT}/0

# CONTEXT REPO: shared knowledge + projects' data (notes, files), apart from the code. Empty = ~/.mbare-pilot
MBARE_PILOT_HOME=

# PROJECTS (folders the project picker may browse, separated by ;  empty = your home folder)
PROJECT_ROOTS=

# SECRETS: Fernet key encrypting the secrets saved in the DB (e.g. Atlassian tokens). Changing it makes them unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MBARE_PILOT_SECRET_KEY=

# LLM PROVIDERS (leave empty the ones you don't use). Models are picked from the catalog in Admin → Modelli.
# OpenRouter is the main one: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434/v1

# DATAPIZZA TRACING (print the per-run trace summary panel to the console)
DATAPIZZA_TRACE_SUMMARY=false
