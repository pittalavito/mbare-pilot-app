# APP
APP_LOG_LEVEL=INFO

# The server (resource/scripts/run-app.py): the app at API_URL, the API at API_URL/api
API_URL=http://127.0.0.1:8000
# Development (resource/scripts/run-web.py): Vite on WEB_PORT, with hot reload, proxies /api to API_URL
WEB_PORT=5173
# restart the API by itself when src/ changes (development)
API_RELOAD=true

# How the scripts start the API, and the worker the API starts (paths from the project root)
API_APP=api:app
API_APP_DIR=src
WORKER_SCRIPT=src/worker.py

# GITHUB COPILOT CLI (agent task delegati: npm install -g @github/copilot, poi copilot -> /login)
COPILOT_COMMAND=copilot
# vuoto = modello predefinito di Copilot
COPILOT_MODEL=
# vuoto = il login fatto con copilot
COPILOT_GITHUB_TOKEN=
COPILOT_PLANNING_TIMEOUT_MINUTES=5
COPILOT_EXECUTION_TIMEOUT_MINUTES=60

# POSTGRES
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST_PORT=5433
POSTGRES_DASHBOARD_PORT=8084
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
# container the DB export runs pg_dump in (resource/docker/docker-compose.yml)
POSTGRES_CONTAINER=mbare-pilot-app-postgres

# BACKUP: DB exports go to <BACKUP_DIR>/db/ (empty = the mbare-pilot-back-up folder next to the project)
BACKUP_DIR=

# REDIS
REDIS_HOST_PORT=6380
REDIS_DASHBOARD_PORT=8083
REDIS_URL=redis://localhost:${REDIS_HOST_PORT}/0

# DATA FOLDER (e.g. mbare-pilot-data): definition/ (agents, chatbots, automations as YAML) and
# files/<project>/ (notes, uploaded files, context), apart from the code. Empty = ~/.mbare-pilot
MBARE_PILOT_HOME=

# PROJECTS (folders the project picker may browse, separated by ;  empty = your home folder)
PROJECT_ROOTS=

# SECRETS: Fernet key encrypting the secrets saved in the DB (e.g. Atlassian tokens). Changing it makes them unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MBARE_PILOT_SECRET_KEY=

# LLM PROVIDERS (leave empty the ones you don't use). Models are picked from the catalog in Admin → Modelli.
# OpenRouter is the main one: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434/v1

# CHATBOT CACHE: a message this similar (cosine 0..1) to one put in cache launches its automation without the agent
CHAT_ROUTE_THRESHOLD=0.9
# embedder of the cache: hashing (a mock, same words = similar) or openrouter/<model>,
# e.g. openrouter/openai/text-embedding-3-small (uses OPENROUTER_API_KEY; the text is masked first)
CHAT_ROUTE_EMBEDDER=hashing

# DATAPIZZA TRACING (print the per-run trace summary panel to the console)
DATAPIZZA_TRACE_SUMMARY=false
